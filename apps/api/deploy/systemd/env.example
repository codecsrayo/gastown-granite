# /etc/gastown/gastown-{api,gt}.env — Gas Town daemon environment.
#
# This file is loaded by the systemd unit. Permissions: 0640, owned by `gastown`.
# Copy and adjust per host.

# Event log (jsonl). Both binaries write to this path; keep them aligned.
GT_EVENT_LOG=/var/lib/gastown/events.jsonl

# Real persistence — leave blank to fall back to in-memory (DEV ONLY).
GT_DOLT_URL=mysql://gastown@127.0.0.1:3307/hq
GT_PG_AUDIT_URL=postgres://gastown:gastown@127.0.0.1:5432/gastown

# gt-web specific.
GT_WEB_BIND=127.0.0.1:8787
# Bearer secret for /api/*. Refusing to start without it is fail-closed.
# Rotate by editing this file + `sudo systemctl restart gastown-api`.
GT_WEB_TOKEN=replace-me-with-32-bytes-of-randomness

# Absolute path to the `gt` binary used by RealEffects::sling (convoy handoff).
GT_BIN=/usr/local/bin/gt

# OTEL → Tempo (optional). Empty disables span export but keeps Prometheus metrics.
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_SERVICE_NAME=gastown-api

# tracing filter. `info` is the production default; bump to `debug` per crate to
# investigate, e.g. `RUST_LOG=info,gt_web=debug`.
RUST_LOG=info
