{
  "title": "Gastown Overview — audit + outbox + projections",
  "uid": "gastown-overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "tags": ["gastown", "overview"],
  "timezone": "",
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "audit_events total",
      "datasource": { "type": "postgres", "uid": "pg-gastown" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT count(*) AS value FROM audit_events;"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "outbox pending",
      "datasource": { "type": "postgres", "uid": "pg-gastown" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT count(*) AS value FROM outbox_events WHERE drained_at IS NULL;"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 200 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "oldest pending (s)",
      "datasource": { "type": "postgres", "uid": "pg-gastown" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT coalesce(extract(epoch FROM now() - min(ts)), 0) AS value FROM outbox_events WHERE drained_at IS NULL;"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "red", "value": 300 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "feed_projections rows",
      "datasource": { "type": "postgres", "uid": "pg-gastown" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT count(*) AS value FROM feed_projections;"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "gt_events_total (Prom)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "sum(gt_events_total)" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "gt-web up",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "up{job=\"gt-web\"}" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ]
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "audit_events insert rate (per minute, by kind)",
      "datasource": { "type": "postgres", "uid": "pg-gastown" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT date_trunc('minute', ts) AS time, kind AS metric, count(*) AS value FROM audit_events WHERE $__timeFilter(ts) GROUP BY 1, 2 ORDER BY 1;"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "stacking": { "mode": "normal" } } },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "gt_events_total rate (Prom, per kind)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (rate(gt_events_total[5m]))",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "barchart",
      "title": "Top kinds (audit_events, time-window)",
      "datasource": { "type": "postgres", "uid": "pg-gastown" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT kind, count(*) AS events FROM audit_events WHERE $__timeFilter(ts) GROUP BY kind ORDER BY events DESC LIMIT 20;"
        }
      ],
      "options": { "xField": "kind", "orientation": "horizontal" }
    },
    {
      "id": 10,
      "type": "table",
      "title": "Top feed_projections by value_num",
      "datasource": { "type": "postgres", "uid": "pg-gastown" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT scope, scope_id, metric, value_num, updated_at FROM feed_projections ORDER BY value_num DESC LIMIT 25;"
        }
      ]
    },
    {
      "id": 11,
      "type": "table",
      "title": "Outbox pending (oldest first)",
      "datasource": { "type": "postgres", "uid": "pg-gastown" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT seq, event_id, kind, ts, extract(epoch FROM now() - ts)::int AS age_s FROM outbox_events WHERE drained_at IS NULL ORDER BY seq ASC LIMIT 50;"
        }
      ]
    }
  ]
}
